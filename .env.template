# =============================================================================
# PaaS AI Stack - Environment Variables
# =============================================================================
# Copy this file to .env and fill in all placeholder values
# Generate secrets: openssl rand -base64 32
# Generate hex passwords: openssl rand -hex 24
# =============================================================================

# -----------------------------------------------------------------------------
# SYSTEM
# -----------------------------------------------------------------------------
TIMEZONE=America/New_York
BASE_DOMAIN=YOUR_DOMAIN_HERE

# -----------------------------------------------------------------------------
# ADMIN ACCOUNT (used for automated setup)
# -----------------------------------------------------------------------------
ADMIN_EMAIL=admin@YOUR_DOMAIN
ADMIN_USERNAME=admin
ADMIN_PASSWORD=GENERATE_WITH_openssl_rand_-base64_16

# -----------------------------------------------------------------------------
# CLOUDFLARE
# -----------------------------------------------------------------------------
# Tunnel Token: Get from Cloudflare Zero Trust → Networks → Tunnels → Your Tunnel → Install connector
#   The token is shown in the docker run command (after "run cloudflared tunnel --token")
CLOUDFLARE_TUNNEL_TOKEN=YOUR_TUNNEL_TOKEN

# API Token: Create at https://dash.cloudflare.com/profile/api-tokens
#   Click "Create Token" → "Create Custom Token"
#   Required Permissions:
#     - Account / Cloudflare Tunnel / Edit (to create/manage tunnels)
#     - Account / Cloudflare Tunnel / Read (to list/verify tunnels)
#     - Account / Workers AI / Edit (for LobeChat RAG embeddings)
#     - Zone / DNS / Edit (to create DNS records for tunnel routes)
#   Account Resources: Include → Your account
#   Zone Resources: Include → Specific zone → Your domain
CLOUDFLARE_API_TOKEN=YOUR_API_TOKEN

# Account ID: Found in Cloudflare Dashboard → Any site → Overview (right sidebar)
#   Or: Zero Trust Dashboard URL contains it: https://one.dash.cloudflare.com/<ACCOUNT_ID>/
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID

# Zone ID: Found in Cloudflare Dashboard → Your site → Overview (right sidebar, under "API")
#   Required for DNS record creation
CLOUDFLARE_ZONE_ID=YOUR_ZONE_ID

# -----------------------------------------------------------------------------
# SERVICE DOMAINS (configure in Cloudflare Tunnel)
# -----------------------------------------------------------------------------
GITEA_DOMAIN=gitea.YOUR_DOMAIN
COOLIFY_DOMAIN=coolify.YOUR_DOMAIN
COOLIFY_REALTIME_DOMAIN=realtime.YOUR_DOMAIN
N8N_DOMAIN=n8n.YOUR_DOMAIN
OPENCLAW_DOMAIN=claw.YOUR_DOMAIN
LOBE_DOMAIN=lobe.YOUR_DOMAIN
CASDOOR_DOMAIN=lobe-auth.YOUR_DOMAIN
MINIO_DOMAIN=lobe-minio.YOUR_DOMAIN

# -----------------------------------------------------------------------------
# GITEA (Git Server)
# -----------------------------------------------------------------------------
GITEA_TOKEN=GENERATE_AFTER_SETUP
GITEA_ACTIONS_TOKEN=GENERATE_AFTER_SETUP
POSTGRES_GIT_USER=gitea
POSTGRES_GIT_PASSWORD=GENERATE_WITH_openssl_rand_-hex_24
POSTGRES_GIT_DB=gitea
# Security settings (bootstrap sets these to true after initial setup)
GITEA_DISABLE_REGISTRATION=false
GITEA_REQUIRE_SIGNIN=false

# -----------------------------------------------------------------------------
# COOLIFY (Deployment Platform)
# -----------------------------------------------------------------------------
COOLIFY_TOKEN=GENERATE_AFTER_SETUP
COOLIFY_APP_KEY=GENERATE_WITH_openssl_rand_-base64_32
POSTGRES_COOLIFY_PASSWORD=GENERATE_WITH_openssl_rand_-hex_24

# -----------------------------------------------------------------------------
# N8N (Workflow Automation)
# -----------------------------------------------------------------------------
N8N_TOKEN=GENERATE_AFTER_SETUP
POSTGRES_N8N_USER=n8n
POSTGRES_N8N_PASSWORD=GENERATE_WITH_openssl_rand_-hex_24
POSTGRES_N8N_DB=n8n

# -----------------------------------------------------------------------------
# LOBECHAT
# -----------------------------------------------------------------------------
LOBE_POSTGRES_PASSWORD=GENERATE_WITH_openssl_rand_-hex_24
LOBE_DB_NAME=lobechat
MINIO_ROOT_USER=lobe_admin
MINIO_ROOT_PASSWORD=GENERATE_WITH_openssl_rand_-base64_24
MINIO_LOBE_BUCKET=lobechat
KEY_VAULTS_SECRET=GENERATE_WITH_openssl_rand_-base64_32
NEXT_AUTH_SECRET=GENERATE_WITH_openssl_rand_-hex_32
JWKS_KEY=GENERATE_WITH_openssl_rand_-base64_32

# -----------------------------------------------------------------------------
# CASDOOR (SSO)
# -----------------------------------------------------------------------------
CASDOOR_CLIENT_ID=CONFIGURE_IN_CASDOOR_UI
CASDOOR_CLIENT_SECRET=CONFIGURE_IN_CASDOOR_UI

# -----------------------------------------------------------------------------
# OPENCLAW (AI GATEWAY)
# -----------------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=GENERATE_WITH_openssl_rand_-hex_32
# Version to build from source (tag, branch, or commit hash)
# Use 'main' for latest, or pin to release tag e.g., 'v2026.1.30'
OPENCLAW_VERSION=main

# -----------------------------------------------------------------------------
# AI API KEYS (for OpenClaw)
# -----------------------------------------------------------------------------
# REQUIRED: At least ONE key below for OpenClaw to work.
# OPTIONAL: Add more keys for additional model options and fallbacks.
#
# Priority order for auto-onboarding:
#   1. ANTHROPIC_API_KEY (default/recommended)
#   2. OPENROUTER_API_KEY (100+ models with one key - great default choice)
#   3. OPENAI_API_KEY
#   4. GEMINI_API_KEY
#
# Where to get keys:
#   Anthropic:   https://console.anthropic.com/settings/keys
#   OpenRouter:  https://openrouter.ai/keys (recommended - access Claude, GPT, Gemini, etc.)
#   OpenAI:      https://platform.openai.com/api-keys
#   Google:      https://aistudio.google.com/apikey
#   DeepSeek:    https://platform.deepseek.com/api_keys
#   Perplexity:  https://www.perplexity.ai/settings/api
#   Brave:       https://brave.com/search/api/
#
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
PERPLEXITY_API_KEY=
BRAVE_API_KEY=

# -----------------------------------------------------------------------------
# TELEGRAM (Required for Telegram channel)
# -----------------------------------------------------------------------------
# Create a bot via @BotFather on Telegram:
#   1. Message @BotFather with /newbot
#   2. Follow prompts to name your bot
#   3. Copy the token (format: 123456789:ABCdefGHI...)
#
# Without this token, OpenClaw cannot create/manage Telegram channels.
TELEGRAM_BOT_TOKEN=

# -----------------------------------------------------------------------------
# OPTIONAL API KEYS (Enhanced Features)
# -----------------------------------------------------------------------------
# These keys enable additional OpenClaw features:
#
# BRAVE_API_KEY - Web search capability
#   Get key: https://brave.com/search/api/
#   Required for: tools.web.search (agent can search the web)
#
# FIRECRAWL_API_KEY - Enhanced web fetch
#   Get key: https://firecrawl.dev/
#   Required for: Better web page content extraction
#
# ELEVENLABS_API_KEY - Text-to-speech
#   Get key: https://elevenlabs.io/
#   Required for: Voice responses, TTS in Telegram/Discord
#
# Note: If you add/change these keys after initial setup,
# run: docker exec openclaw-cli node dist/index.js configure
# Or delete the onboard marker and restart:
#   docker exec openclaw-cli rm /root/.openclaw/.onboarded
#   docker compose restart openclaw-cli

FIRECRAWL_API_KEY=
ELEVENLABS_API_KEY=

# =============================================================================
# PaaS AI Stack - Environment Variables
# Generated by Ansible - {{ ansible_date_time.iso8601 }}
# =============================================================================

# -----------------------------------------------------------------------------
# SYSTEM
# -----------------------------------------------------------------------------
TIMEZONE={{ timezone }}
BASE_DOMAIN={{ base_domain }}

# -----------------------------------------------------------------------------
# ADMIN ACCOUNT (used for automated setup)
# -----------------------------------------------------------------------------
ADMIN_EMAIL={{ admin_email }}
ADMIN_USERNAME={{ admin_username }}
ADMIN_PASSWORD={{ admin_password }}

# -----------------------------------------------------------------------------
# CLOUDFLARE
# -----------------------------------------------------------------------------
# Tunnel Token: Get from Cloudflare Zero Trust → Networks → Tunnels → Your Tunnel → Install connector
CLOUDFLARE_TUNNEL_TOKEN={{ cloudflare_tunnel_token }}

# API Token: Create at https://dash.cloudflare.com/profile/api-tokens
CLOUDFLARE_API_TOKEN={{ cloudflare_api_token }}

# Account ID: Found in Cloudflare Dashboard → Any site → Overview (right sidebar)
CLOUDFLARE_ACCOUNT_ID={{ cloudflare_account_id }}

# Zone ID: Found in Cloudflare Dashboard → Your site → Overview (right sidebar, under "API")
CLOUDFLARE_ZONE_ID={{ cloudflare_zone_id }}

# -----------------------------------------------------------------------------
# SERVICE DOMAINS (configure in Cloudflare Tunnel)
# -----------------------------------------------------------------------------
GITEA_DOMAIN={{ gitea_domain }}
COOLIFY_DOMAIN={{ coolify_domain }}
COOLIFY_REALTIME_DOMAIN={{ coolify_realtime_domain }}
N8N_DOMAIN={{ n8n_domain }}
OPENCLAW_DOMAIN={{ openclaw_domain }}
LOBE_DOMAIN={{ lobe_domain }}
CASDOOR_DOMAIN={{ casdoor_domain }}
MINIO_DOMAIN={{ minio_domain }}

# -----------------------------------------------------------------------------
# GITEA (Git Server)
# -----------------------------------------------------------------------------
GITEA_TOKEN={{ gitea_token }}
GITEA_ACTIONS_TOKEN={{ gitea_actions_token }}
POSTGRES_GIT_USER={{ postgres_git_user }}
POSTGRES_GIT_PASSWORD={{ postgres_git_password }}
POSTGRES_GIT_DB={{ postgres_git_db }}
# Security settings (bootstrap sets these to true after initial setup)
GITEA_DISABLE_REGISTRATION={{ gitea_disable_registration }}
GITEA_REQUIRE_SIGNIN={{ gitea_require_signin }}

# -----------------------------------------------------------------------------
# COOLIFY (Deployment Platform)
# -----------------------------------------------------------------------------
COOLIFY_TOKEN={{ coolify_token }}
COOLIFY_APP_KEY={{ coolify_app_key }}
POSTGRES_COOLIFY_PASSWORD={{ postgres_coolify_password }}

# -----------------------------------------------------------------------------
# N8N (Workflow Automation)
# -----------------------------------------------------------------------------
N8N_TOKEN={{ n8n_token }}
POSTGRES_N8N_USER={{ postgres_n8n_user }}
POSTGRES_N8N_PASSWORD={{ postgres_n8n_password }}
POSTGRES_N8N_DB={{ postgres_n8n_db }}

# -----------------------------------------------------------------------------
# LOBECHAT
# -----------------------------------------------------------------------------
LOBE_POSTGRES_PASSWORD={{ lobe_postgres_password }}
LOBE_DB_NAME={{ lobe_db_name }}
MINIO_ROOT_USER={{ minio_root_user }}
MINIO_ROOT_PASSWORD={{ minio_root_password }}
MINIO_LOBE_BUCKET={{ minio_lobe_bucket }}
KEY_VAULTS_SECRET={{ key_vaults_secret }}
NEXT_AUTH_SECRET={{ next_auth_secret }}
JWKS_KEY={{ jwks_key }}

# -----------------------------------------------------------------------------
# CASDOOR (SSO)
# -----------------------------------------------------------------------------
CASDOOR_CLIENT_ID={{ casdoor_client_id }}
CASDOOR_CLIENT_SECRET={{ casdoor_client_secret }}

# -----------------------------------------------------------------------------
# OPENCLAW (AI GATEWAY)
# -----------------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN={{ openclaw_gateway_token }}
# Version to build from source (tag, branch, or commit hash)
OPENCLAW_VERSION={{ openclaw_version }}

# -----------------------------------------------------------------------------
# AI API KEYS (for OpenClaw)
# -----------------------------------------------------------------------------
# REQUIRED: At least ONE key below for OpenClaw to work.
ANTHROPIC_API_KEY={{ anthropic_api_key }}
OPENAI_API_KEY={{ openai_api_key }}
OPENROUTER_API_KEY={{ openrouter_api_key }}
GEMINI_API_KEY={{ gemini_api_key }}
DEEPSEEK_API_KEY={{ deepseek_api_key }}
PERPLEXITY_API_KEY={{ perplexity_api_key }}
BRAVE_API_KEY={{ brave_api_key }}

# -----------------------------------------------------------------------------
# TELEGRAM (Required for Telegram channel)
# -----------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN={{ telegram_bot_token }}

# -----------------------------------------------------------------------------
# OPTIONAL API KEYS (Enhanced Features)
# -----------------------------------------------------------------------------
FIRECRAWL_API_KEY={{ firecrawl_api_key }}
ELEVENLABS_API_KEY={{ elevenlabs_api_key }}

---
# =============================================================================
# Production Inventory Example
# =============================================================================
# Copy to production.yml and fill in your server details:
#   cp production.yml.example production.yml
#
# Then run:
#   ansible-playbook -i inventory/production.yml bootstrap.yml
# =============================================================================

all:
  hosts:
    paas-server:
      # SSH connection details
      ansible_host: your-server-ip-or-hostname  # e.g., 192.168.1.100 or myserver.example.com
      ansible_user: your-ssh-user               # e.g., ubuntu, root, pi
      ansible_ssh_private_key_file: ~/.ssh/id_ed25519
      ansible_become: true                      # Required for Docker operations
      ansible_become_method: sudo
      
      # For Raspberry Pi or ARM64 servers
      # ansible_python_interpreter: /usr/bin/python3

  vars:
    # ==========================================================================
    # Required Variables (override group_vars/all.yml)
    # ==========================================================================
    base_domain: your-domain.com
    admin_email: admin@your-domain.com
    admin_username: admin
    admin_password: your-strong-password-here  # Min 12 chars

    # Cloudflare - Option 1: Existing tunnel token
    cloudflare_tunnel_token: your-tunnel-token
    
    # Cloudflare - Option 2: API credentials (leave tunnel_token empty)
    # cloudflare_api_token: your-api-token
    # cloudflare_account_id: your-account-id
    # cloudflare_zone_id: your-zone-id

    # AI API Keys (at least one required)
    anthropic_api_key: ""       # Recommended
    openrouter_api_key: ""      # Alternative: 100+ models
    
    # Optional: Telegram bot
    telegram_bot_token: ""
    
    # Optional: Deploy sample app
    deploy_sample_app: true
